{
  "manifest_version": 3,
  "key": "",
  "name": "QuickGet Remote for QNAP",
  "version": "2.1.0",
  "description": "Send links and torrents to QNAP Download Station from Chrome.",
  "default_locale": "en",
  "minimum_chrome_version": "120",
  "icons": {
    "32": "icons/32_download.png",
    "48": "icons/48_download.png",
    "96": "icons/96_download.png",
    "128": "icons/128_download.png"
  },
  "permissions": [
    "contextMenus",
    "storage",
    "alarms",
    "notifications",
    "downloads",
    "scripting"
  ],
  "host_permissions": [
    "http://*/",
    "https://*/"
  ],
  "action": {
    "default_icon": {
      "32": "icons/32_download.png"
    },
    "default_title": "QuickGet Remote - QNAP Download Station 5 client",
    "default_popup": "src/popup/index.html"
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content/magnet.ts"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "options_ui": {
    "page": "src/popup/index.html",
    "open_in_tab": false
  }
}
