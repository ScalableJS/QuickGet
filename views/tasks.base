filters:
  and:
    - file.inFolder("tasks")
    - type == "task"
    - file.name != "TEMPLATE"
properties:
  file.name:
    displayName: Task
  status:
    displayName: Status
  priority:
    displayName: Priority
  area:
    displayName: Area
  board:
    displayName: Workstream
  updated:
    displayName: Updated
  id:
    displayName: ID
views:
  - type: kanban
    name: Board
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - priority
      - board
      - area
      - updated
    boardColumns:
      - discussion
      - todo
      - doing
      - review
      - blocked
      - partial
      - deferred
      - rejected
      - done
  - type: table
    name: All tasks
    order:
      - file.name
      - status
      - priority
      - board
      - area
      - updated
      - id
    sort:
      - property: priority
        direction: ASC
      - property: file.name
        direction: ASC
