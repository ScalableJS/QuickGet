{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "entry": [
    "src/popup/index.ts!",
    "src/background/index.ts!",
    "src/content/magnet.ts!",
    "scripts/**/*.{js,mjs,ts}",
    "tests/**/*.{test,spec}.{js,mjs,ts}",
    "tests/setup.ts",
    ".storybook/{main,preview,chromeMock}.ts",
    "vite.config.ts!",
    "vitest.config.ts",
    "uno.config.ts!",
    "svelte.config.js!",
    "playwright.config.ts",
    "aliases.config.ts!"
  ],
  "project": [
    "src/**/*.{ts,svelte}!",
    "scripts/**/*.{js,mjs,ts}",
    "tests/**/*.{js,mjs,ts}",
    ".storybook/**/*.ts",
    "vite.config.ts!",
    "vitest.config.ts",
    "uno.config.ts!",
    "svelte.config.js!",
    "playwright.config.ts",
    "aliases.config.ts!",
    "!src/**/*Gallery.svelte!",
    "!src/**/*Showcase.svelte!"
  ]
}
